  codeText: "\nint main()\n{\n    cat = 5\n}"
  codeImage: {fileID: 21300000, guid: d43959f25d176488fab8df76f207897f, type: 3}
  rawFeedbackImage: {fileID: 21300000, guid: b048dfd1178050d62b4d82808627dd77, type: 3}
