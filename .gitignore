# Crash reports, logs and temporary/backup snapshots.
mono_crash.*
crash.dmp
sysinfo.txt
*.stackdump
*.log
*.tmp
*.bak

# Participant/preview records and copied study exports are private local data.
# Deliberately do not ignore every CSV or JSON: research inputs and Unity package
# manifests may legitimately be source-controlled.
StudySessions/
MeowraLoggingCheck-*/
MeowraPersistenceCheck-*/
/Results/
/DataExports/
#session.json
#assignment.csv
#trials.csv
#ueqs.csv
#api.csv
#preference.csv

